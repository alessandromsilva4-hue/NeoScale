rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function userProfile() {
      return get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return signedIn() && userProfile().funcao == 'ADMINISTRADOR';
    }

    function isCashier() {
      return isAdmin() || userProfile().funcao == 'CAIXA';
    }

    function isOperator() {
      return isCashier() || userProfile().funcao == 'OPERADOR';
    }

    function isWaiter() {
      return signedIn() && userProfile().funcao == 'GARCOM';
    }

    function accessInitialized() {
      return exists(/databases/$(database)/documents/configuracoes/controleAcesso);
    }

    match /usuarios/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      // O primeiro administrador é criado uma única vez em criar-acesso.html,
      // junto com configuracoes/controleAcesso, no mesmo lote de gravação.
      allow create: if isAdmin() || (
                      signedIn()
                      && request.auth.uid == uid
                      && request.resource.data.funcao == 'ADMINISTRADOR'
                      && !accessInitialized()
                      && getAfter(/databases/$(database)/documents/configuracoes/controleAcesso).data.inicializado == true
                    );
      allow update, delete: if isAdmin();
    }

    match /configuracoes/controleAcesso {
      allow read: if isAdmin();
      allow create: if signedIn()
                    && !accessInitialized()
                    && getAfter(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.funcao == 'ADMINISTRADOR';
      allow update, delete: if isAdmin();
    }

    match /comandas/{id} {
      allow read: if isOperator() || isWaiter();
      allow create: if isOperator() || isWaiter();
      allow update: if isCashier() || (isWaiter() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['itens','total','atualizadoEm','status','transferidaPara','transferidaParaId','transferidaEm','recebeuDe','recebeuItensEm']));
      allow delete: if isAdmin() || (isCashier() && resource.data.status == 'CANCELADA');
    }

    match /cancelamentosComandas/{id} {
      allow read, create: if isCashier();
      allow update: if isCashier();
      allow delete: if isAdmin();
    }

    match /requisicoesCompra/{id} {
      allow read: if isOperator() || isWaiter();
      allow create, update: if isOperator();
      allow delete: if isAdmin() || (isCashier() && resource.data.status == 'CANCELADA');
    }

    match /cotacoesCompra/{id} {
      allow read: if isOperator() || isWaiter();
      allow create, update: if isOperator();
      allow delete: if isAdmin();
    }

    match /cotacoesFornecedores/{token} {
      // O ID do documento é o próprio token do link enviado ao fornecedor.
      // O fornecedor consegue ler somente sua cotação, sem listar a coleção.
      allow get: if resource.data.token == token;
      allow list: if isOperator();
      allow create: if isOperator();
      allow update: if isOperator() || (
                      request.resource.data.token == resource.data.token
                      && resource.data.token == token
                      && request.resource.data.cotacaoId == resource.data.cotacaoId
                      && request.resource.data.fornecedorId == resource.data.fornecedorId
                      && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                        'itens', 'valorProdutos', 'frete', 'totalFinal',
                        'prazoEntrega', 'condicaoPagamento', 'observacoes',
                        'status', 'respondidaEm', 'atualizadoEm'
                      ])
                    );
      allow delete: if isAdmin();
    }

    match /pedidosCompra/{id} {
      allow read: if isOperator() || isWaiter();
      allow create, update: if isOperator();
      allow delete: if isAdmin() || (isCashier() && resource.data.status == 'CANCELADO');
    }

    match /historico/{id} {
      allow read: if isOperator() || isWaiter();
      allow create: if isOperator() || isWaiter();
      allow update: if isCashier() || (isWaiter() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['itens','total','atualizadoEm','status','transferidaPara','transferidaParaId','transferidaEm','recebeuDe','recebeuItensEm']));
      allow delete: if isAdmin();
    }

    match /caixas/{id} {
      allow read: if isCashier();
      allow create, update: if isCashier();
      allow delete: if isAdmin();
    }

    match /contasPagar/{id} {
      allow read, create, update: if isCashier();
      allow delete: if isAdmin();
    }

    match /movimentosCaixa/{id} {
      allow read, create: if isCashier();
      allow update, delete: if isAdmin();
    }

    match /caixasDelivery/{id} {
      allow read, create, update: if isCashier();
      allow delete: if isAdmin();
    }

    match /movimentosCaixaDelivery/{id} {
      allow read, create: if isCashier();
      allow update, delete: if isAdmin();
    }

    match /acertosEntregadores/{id} {
      allow read, create: if isCashier();
      allow update, delete: if isAdmin();
    }

    match /{colecao}/{id} {
      allow read: if isOperator() || isWaiter();
      allow create, update, delete: if isAdmin();
    }
  }
}

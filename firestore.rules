rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function userProfile() {
      return get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return signedIn() && userProfile().funcao == 'ADMINISTRADOR';
    }

    function isCashier() {
      return isAdmin() || userProfile().funcao == 'CAIXA';
    }

    function isOperator() {
      return isCashier() || userProfile().funcao == 'OPERADOR';
    }

    function accessInitialized() {
      return exists(/databases/$(database)/documents/configuracoes/controleAcesso);
    }

    match /usuarios/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      // O primeiro administrador é criado uma única vez em criar-acesso.html,
      // junto com configuracoes/controleAcesso, no mesmo lote de gravação.
      allow create: if isAdmin() || (
                      signedIn()
                      && request.auth.uid == uid
                      && request.resource.data.funcao == 'ADMINISTRADOR'
                      && !accessInitialized()
                      && getAfter(/databases/$(database)/documents/configuracoes/controleAcesso).data.inicializado == true
                    );
      allow update, delete: if isAdmin();
    }

    match /configuracoes/controleAcesso {
      allow read: if isAdmin();
      allow create: if signedIn()
                    && !accessInitialized()
                    && getAfter(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.funcao == 'ADMINISTRADOR';
      allow update, delete: if isAdmin();
    }

    match /comandas/{id} {
      allow read: if isOperator();
      allow create: if isOperator();
      allow update: if isCashier();
      allow delete: if isAdmin();
    }

    match /historico/{id} {
      allow read: if isOperator();
      allow create: if isOperator();
      allow update: if isCashier();
      allow delete: if isAdmin();
    }

    match /caixas/{id} {
      allow read: if isCashier();
      allow create, update: if isCashier();
      allow delete: if isAdmin();
    }

    match /movimentosCaixa/{id} {
      allow read, create: if isCashier();
      allow update, delete: if isAdmin();
    }

    match /caixasDelivery/{id} {
      allow read, create, update: if isCashier();
      allow delete: if isAdmin();
    }

    match /movimentosCaixaDelivery/{id} {
      allow read, create: if isCashier();
      allow update, delete: if isAdmin();
    }

    match /acertosEntregadores/{id} {
      allow read, create: if isCashier();
      allow update, delete: if isAdmin();
    }

    match /{colecao}/{id} {
      allow read: if isOperator();
      allow create, update, delete: if isAdmin();
    }
  }
}
